---
// Componente de lectura de capitulo completo - versiculo por versiculo
// Con highlight, auto-scroll, progreso, y control de velocidad
interface Props {
  versiculos: { numero: number; texto: string; titulo?: string }[];
  label?: string;
}

const { versiculos, label = "Leer capitulo completo" } = Astro.props;
const uniqueId = `chapter-${Date.now()}-${Math.random().toString(36).substring(2, 11)}`;
const versiculosJSON = JSON.stringify(versiculos);
---

<div class="space-y-4" id={`controls-${uniqueId}`}>
  <!-- Controles principales -->
  <div class="inline-flex gap-3 flex-wrap items-center">
    <button
      type="button"
      class="btn-play-chapter inline-flex items-center gap-2 px-8 py-4 bg-green-600 text-white rounded-lg hover:bg-green-700 focus:ring-4 focus:ring-green-300 transition-colors font-semibold text-xl shadow-lg"
      id={`play-${uniqueId}`}
      aria-label={label}
    >
      <span class="text-3xl" aria-hidden="true">&#9654;</span>
      <span>{label}</span>
    </button>

    <button
      type="button"
      class="btn-toggle-chapter hidden items-center gap-2 px-8 py-4 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 focus:ring-4 focus:ring-yellow-300 transition-colors font-semibold text-xl shadow-lg"
      id={`toggle-${uniqueId}`}
      aria-label="Pausar"
    >
      <span class="toggle-icon text-3xl" aria-hidden="true">&#9208;</span>
      <span class="toggle-label">Pausar</span>
    </button>

    <button
      type="button"
      class="btn-stop-chapter hidden items-center gap-2 px-8 py-4 bg-red-600 text-white rounded-lg hover:bg-red-700 focus:ring-4 focus:ring-red-300 transition-colors font-semibold text-xl shadow-lg"
      id={`stop-${uniqueId}`}
      aria-label="Detener"
    >
      <span class="text-3xl" aria-hidden="true">&#9209;</span>
      <span>Detener</span>
    </button>
  </div>

  <!-- Control de velocidad -->
  <div class="speed-control-shell flex items-center gap-3 flex-wrap rounded-lg border border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-800/70 px-3 py-2 shadow-sm">
    <label
      for={`speed-${uniqueId}`}
      class="speed-control-label text-sm font-semibold text-gray-700 dark:text-gray-300"
    >
      Velocidad:
    </label>
    <input
      type="range"
      id={`speed-${uniqueId}`}
      min="0.5"
      max="2.0"
      step="0.1"
      class="speed-slider w-36 sm:w-44 h-2 rounded-full appearance-none cursor-pointer"
      aria-label="Velocidad de lectura"
    />
    <span
      id={`speed-label-${uniqueId}`}
      class="speed-value inline-flex items-center justify-center min-w-[3.4rem] px-2 py-1 rounded-md bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-sm font-mono font-semibold text-blue-700 dark:text-blue-300"
      >0.9x</span
    >
  </div>

  <!-- Barra de progreso -->
  <div id={`progress-${uniqueId}`} class="hidden">
    <div class="flex items-center gap-3">
      <div
        class="flex-1 bg-gray-200 dark:bg-gray-700 rounded-full h-3 overflow-hidden"
      >
        <div
          id={`progress-bar-${uniqueId}`}
          class="bg-green-500 h-3 rounded-full transition-all duration-300"
          style="width: 0%"
        >
        </div>
      </div>
      <span
        id={`progress-text-${uniqueId}`}
        class="text-sm font-semibold text-gray-600 dark:text-gray-400 min-w-20 text-right"
      >
        0 / 0
      </span>
    </div>
  </div>

  <!-- Tip recomendando Edge -->
  <p class="text-xs text-gray-400 dark:text-gray-500 italic">
    Para mejor calidad de voz, usa Microsoft Edge
  </p>
  <!-- Mini reproductor sticky para mobile -->
  <div
    id={`sticky-${uniqueId}`}
    class="chapter-sticky-player hidden sm:hidden fixed left-3 right-3 bottom-3 z-60"
    aria-live="polite"
  >
    <div class="rounded-xl border border-blue-300 dark:border-blue-700 bg-white/95 dark:bg-gray-900/95 shadow-xl backdrop-blur px-3 py-3">
      <div class="flex items-center justify-between gap-3 mb-2">
        <p class="text-sm font-semibold text-blue-700 dark:text-blue-300">Leyendo capitulo</p>
        <span id={`sticky-progress-${uniqueId}`} class="text-xs font-mono text-gray-600 dark:text-gray-300">0 / 0</span>
      </div>
      <div class="flex items-center gap-2">
        <button
          id={`sticky-toggle-${uniqueId}`}
          type="button"
          class="hidden flex-1 inline-flex items-center justify-center gap-2 px-3 py-2 bg-yellow-600 text-white rounded-lg font-semibold text-sm focus:ring-4 focus:ring-yellow-300"
          aria-label="Pausar lectura"
        >
          <span class="sticky-toggle-icon" aria-hidden="true">&#9208;</span>
          <span class="sticky-toggle-label">Pausar</span>
        </button>
        <button
          id={`sticky-stop-${uniqueId}`}
          type="button"
          class="hidden inline-flex items-center justify-center gap-2 px-3 py-2 bg-red-600 text-white rounded-lg font-semibold text-sm focus:ring-4 focus:ring-red-300"
          aria-label="Detener lectura"
        >
          <span aria-hidden="true">&#9209;</span>
          Detener
        </button>
      </div>
    </div>
  </div></div>

<script is:inline data-astro-rerun define:vars={{ uniqueId, versiculosJSON }}>
  (function () {
    var controlsId = uniqueId;
    var verses = JSON.parse(versiculosJSON);

    // Preferencias
    var RATE_KEY = "biblia-speech-rate";
    var VOICE_KEY = "biblia-voice-name";

    function getSavedRate() {
      try {
        return parseFloat(localStorage.getItem(RATE_KEY)) || 0.9;
      } catch (e) {
        return 0.9;
      }
    }

    function saveRate(r) {
      try {
        localStorage.setItem(RATE_KEY, r.toString());
      } catch (e) {}
    }

    function getSavedVoiceName() {
      try {
        return localStorage.getItem(VOICE_KEY);
      } catch (e) {
        return null;
      }
    }

    function getBestVoice() {
      var allVoices = window.speechSynthesis.getVoices();
      var spanish = allVoices.filter(function (v) {
        return v.lang.indexOf("es") === 0;
      });
      if (spanish.length === 0) return null;

      var savedName = getSavedVoiceName();
      if (savedName) {
        var saved = spanish.find(function (v) {
          return v.name === savedName;
        });
        if (saved) return saved;
      }

      var keywords = [
        "Neural",
        "Google",
        "Monica",
        "Paulina",
        "Jorge",
        "Microsoft",
      ];
      for (var i = 0; i < keywords.length; i++) {
        var match = spanish.find(function (v) {
          return v.name.indexOf(keywords[i]) >= 0;
        });
        if (match) return match;
      }
      return spanish[0];
    }

    // Pre-cargar voces al inicio (movil las carga async)
    function preloadVoices() {
      window.speechSynthesis.getVoices();
      if (typeof window.speechSynthesis.onvoiceschanged !== "undefined") {
        window.speechSynthesis.onvoiceschanged = function () {
          window.speechSynthesis.getVoices();
        };
      }
    }

    function initControls() {
      var playBtn = document.getElementById("play-" + controlsId);
      var toggleBtn = document.getElementById("toggle-" + controlsId);
      var stopBtn = document.getElementById("stop-" + controlsId);
      var speedSlider = document.getElementById("speed-" + controlsId);
      var speedLabel = document.getElementById("speed-label-" + controlsId);
      var progressContainer = document.getElementById("progress-" + controlsId);
      var progressBar = document.getElementById("progress-bar-" + controlsId);
      var progressText = document.getElementById("progress-text-" + controlsId);
      var stickyContainer = document.getElementById("sticky-" + controlsId);
      var stickyToggleBtn = document.getElementById("sticky-toggle-" + controlsId);
      var stickyStopBtn = document.getElementById("sticky-stop-" + controlsId);
      var stickyProgressText = document.getElementById("sticky-progress-" + controlsId);

      if (!playBtn || !window.speechSynthesis) return;

      // Pre-cargar voces lo antes posible
      preloadVoices();

      var currentIndex = 0;
      var isPlaying = false;
      var isPausedManually = false;
      var stallRecoveryTimer = null; // Recupera cuando mobile se congela
      var currentVerseChunks = [];
      var currentChunkIndex = 0;
      var currentChunkRetryCount = 0;
      var lastSpeechActivityAt = 0;
      var wakeLockSentinel = null;

      // Inicializar slider de velocidad
      var currentRate = getSavedRate();
      if (speedSlider) {
        speedSlider.value = currentRate.toString();
        speedSlider.style.setProperty(
          "--speed-progress",
          (((currentRate - 0.5) / 1.5) * 100).toFixed(2) + "%",
        );
        speedLabel.textContent = currentRate.toFixed(1) + "x";
        speedSlider.addEventListener("input", function () {
          currentRate = parseFloat(speedSlider.value);
          speedSlider.style.setProperty(
            "--speed-progress",
            (((currentRate - 0.5) / 1.5) * 100).toFixed(2) + "%",
          );
          speedLabel.textContent = currentRate.toFixed(1) + "x";
          saveRate(currentRate);
        });
      }

      function updateToggleButton() {
        if (!toggleBtn) return;
        var toggleIcon = toggleBtn.querySelector(".toggle-icon");
        var toggleLabel = toggleBtn.querySelector(".toggle-label");

        if (isPausedManually) {
          toggleBtn.classList.remove(
            "bg-yellow-600",
            "hover:bg-yellow-700",
            "focus:ring-yellow-300",
          );
          toggleBtn.classList.add(
            "bg-blue-600",
            "hover:bg-blue-700",
            "focus:ring-blue-300",
          );
          toggleBtn.setAttribute("aria-label", "Continuar");
          if (toggleIcon) toggleIcon.textContent = "▶";
          if (toggleLabel) toggleLabel.textContent = "Continuar";
        } else {
          toggleBtn.classList.remove(
            "bg-blue-600",
            "hover:bg-blue-700",
            "focus:ring-blue-300",
          );
          toggleBtn.classList.add(
            "bg-yellow-600",
            "hover:bg-yellow-700",
            "focus:ring-yellow-300",
          );
          toggleBtn.setAttribute("aria-label", "Pausar");
          if (toggleIcon) toggleIcon.textContent = "⏸";
          if (toggleLabel) toggleLabel.textContent = "Pausar";
        }
      }

      function updateStickyToggleButton() {
        if (!stickyToggleBtn) return;
        var stickyToggleIcon = stickyToggleBtn.querySelector(".sticky-toggle-icon");
        var stickyToggleLabel = stickyToggleBtn.querySelector(".sticky-toggle-label");

        if (isPausedManually) {
          stickyToggleBtn.classList.remove("bg-yellow-600", "focus:ring-yellow-300");
          stickyToggleBtn.classList.add("bg-blue-600", "focus:ring-blue-300");
          stickyToggleBtn.setAttribute("aria-label", "Continuar lectura");
          if (stickyToggleIcon) stickyToggleIcon.textContent = "▶";
          if (stickyToggleLabel) stickyToggleLabel.textContent = "Continuar";
        } else {
          stickyToggleBtn.classList.remove("bg-blue-600", "focus:ring-blue-300");
          stickyToggleBtn.classList.add("bg-yellow-600", "focus:ring-yellow-300");
          stickyToggleBtn.setAttribute("aria-label", "Pausar lectura");
          if (stickyToggleIcon) stickyToggleIcon.textContent = "⏸";
          if (stickyToggleLabel) stickyToggleLabel.textContent = "Pausar";
        }
      }

      function updateButtons() {
        updateToggleButton();
        updateStickyToggleButton();

        if (isPlaying || isPausedManually) {
          playBtn.classList.add("hidden");
          toggleBtn.classList.remove("hidden");
          toggleBtn.classList.add("inline-flex");
          stopBtn.classList.remove("hidden");
          stopBtn.classList.add("inline-flex");

          if (stickyContainer) stickyContainer.classList.remove("hidden");
          if (stickyToggleBtn) stickyToggleBtn.classList.remove("hidden");
          if (stickyStopBtn) stickyStopBtn.classList.remove("hidden");
        } else {
          playBtn.classList.remove("hidden");
          toggleBtn.classList.add("hidden");
          toggleBtn.classList.remove("inline-flex");
          stopBtn.classList.add("hidden");
          stopBtn.classList.remove("inline-flex");

          if (stickyContainer) stickyContainer.classList.add("hidden");
          if (stickyToggleBtn) stickyToggleBtn.classList.add("hidden");
          if (stickyStopBtn) stickyStopBtn.classList.add("hidden");
        }
      }

      function updateProgress(index, total) {
        if (!progressContainer || !progressBar || !progressText) return;
        progressContainer.classList.remove("hidden");
        var pct = total > 0 ? ((index + 1) / total) * 100 : 0;
        progressBar.style.width = pct + "%";
        progressText.textContent = index + 1 + " / " + total;
        if (stickyProgressText) {
          stickyProgressText.textContent = index + 1 + " / " + total;
        }
      }

      function highlightVerse(verseNum) {
        // Quitar highlight anterior
        var prevHL = document.querySelectorAll(".verse-highlight");
        prevHL.forEach(function (el) {
          el.classList.remove("verse-highlight");
        });

        // Agregar highlight al versiculo actual
        var verseEl = document.getElementById("v" + verseNum);
        if (verseEl) {
          verseEl.classList.add("verse-highlight");
          // Auto-scroll suave
          verseEl.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      }

      function clearHighlight() {
        var highlighted = document.querySelectorAll(".verse-highlight");
        highlighted.forEach(function (el) {
          el.classList.remove("verse-highlight");
        });
      }

      // Divide texto largo en fragmentos cortos para mejorar estabilidad en mobile
      function splitTextForMobileSpeech(text) {
        var cleaned = (text || "").replace(/\s+/g, " ").trim();
        if (!cleaned) return [];

        // Cortes naturales por puntuacion
        var parts = cleaned
          .split(/([,;:.!?]+)/)
          .reduce(function (acc, part) {
            if (!part) return acc;
            if (/^[,;:.!?]+$/.test(part) && acc.length > 0) {
              acc[acc.length - 1] += part;
            } else {
              acc.push(part);
            }
            return acc;
          }, []);

        var chunks = [];
        var isMobile =
          typeof navigator !== "undefined" &&
          /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent || "");
        var maxLen = isMobile ? 70 : 140;
        var current = "";
        for (var i = 0; i < parts.length; i++) {
          var next = parts[i].trim();
          if (!next) continue;

          if (!current) {
            current = next;
            continue;
          }

          if ((current + " " + next).length <= maxLen) {
            current += " " + next;
          } else {
            chunks.push(current);
            current = next;
          }
        }
        if (current) chunks.push(current);

        // Fallback si queda un bloque largo: dividir por palabras, no por caracteres
        var safeChunks = [];
        chunks.forEach(function (chunk) {
          if (chunk.length <= maxLen) {
            safeChunks.push(chunk);
            return;
          }

          var words = chunk.split(/\s+/).filter(Boolean);
          var currentWordChunk = "";
          for (var j = 0; j < words.length; j++) {
            var word = words[j];
            var candidate = currentWordChunk
              ? currentWordChunk + " " + word
              : word;

            if (candidate.length <= maxLen) {
              currentWordChunk = candidate;
            } else {
              if (currentWordChunk) {
                safeChunks.push(currentWordChunk);
              }
              // Si una palabra sola supera maxLen, se deja completa
              currentWordChunk = word;
            }
          }
          if (currentWordChunk) {
            safeChunks.push(currentWordChunk);
          }
        });

        return safeChunks;
      }

      function stopRecoveryTimers() {
        if (stallRecoveryTimer) {
          clearInterval(stallRecoveryTimer);
          stallRecoveryTimer = null;
        }
      }

      function acquireWakeLock() {
        if (!("wakeLock" in navigator) || wakeLockSentinel) return;
        if (document.visibilityState !== "visible") return;
        navigator.wakeLock
          .request("screen")
          .then(function (sentinel) {
            wakeLockSentinel = sentinel;
            sentinel.addEventListener("release", function () {
              wakeLockSentinel = null;
            });
          })
          .catch(function () {
            // Wake Lock no soportado o denegado
          });
      }

      function releaseWakeLock() {
        if (!wakeLockSentinel) return;
        wakeLockSentinel
          .release()
          .catch(function () {})
          .finally(function () {
            wakeLockSentinel = null;
          });
      }

      function startRecoveryTimers() {
        stopRecoveryTimers();
        stallRecoveryTimer = setInterval(function () {
          if (!isPlaying || isPausedManually) return;
          var synth = window.speechSynthesis;
          if (!synth) return;

          // Si el motor se queda silencioso sin onend/onerror, reintentar flujo
          if (!synth.speaking && Date.now() - lastSpeechActivityAt > 2200) {
            if (currentChunkIndex < currentVerseChunks.length) {
              speakCurrentChunk();
            } else {
              speakVerse(currentIndex + 1);
            }
          }
        }, 1200);
      }

      function speakCurrentChunk() {
        if (!isPlaying) return;
        if (currentChunkIndex >= currentVerseChunks.length) {
          speakVerse(currentIndex + 1);
          return;
        }

        var chunkText = currentVerseChunks[currentChunkIndex];
        var utterance = new SpeechSynthesisUtterance(chunkText);
        utterance.lang = "es-ES";
        utterance.rate = currentRate;
        utterance.pitch = 1.0;
        utterance.volume = 1.0;

        var voice = getBestVoice();
        if (voice) {
          utterance.voice = voice;
          utterance.lang = voice.lang;
        }

        utterance.onstart = function () {
          lastSpeechActivityAt = Date.now();
        };

        utterance.onboundary = function () {
          lastSpeechActivityAt = Date.now();
        };

        utterance.onend = function () {
          if (!isPlaying) return;
          lastSpeechActivityAt = Date.now();
          currentChunkRetryCount = 0;
          currentChunkIndex += 1;
          speakCurrentChunk();
        };

        utterance.onerror = function (ev) {
          if (!isPlaying) return;
          if (isPausedManually) return;
          if (ev.error === "interrupted" || ev.error === "canceled") {
            if (currentChunkRetryCount < 1) {
              currentChunkRetryCount += 1;
              setTimeout(speakCurrentChunk, 120);
              return;
            }
          }

          lastSpeechActivityAt = Date.now();
          currentChunkRetryCount = 0;
          currentChunkIndex += 1;
          speakCurrentChunk();
        };

        window.speechSynthesis.speak(utterance);
      }

      function speakVerse(index) {
        if (!isPlaying || index >= verses.length) {
          // Termino la lectura
          isPlaying = false;
          isPausedManually = false;
          clearHighlight();
          updateButtons();
          stopRecoveryTimers();
          releaseWakeLock();
          if (progressContainer) {
            setTimeout(function () {
              progressContainer.classList.add("hidden");
            }, 2000);
          }
          return;
        }

        currentIndex = index;
        var verse = verses[index];
        highlightVerse(verse.numero);
        updateProgress(index, verses.length);
        currentVerseChunks = splitTextForMobileSpeech(verse.texto);
        currentChunkIndex = 0;
        currentChunkRetryCount = 0;
        lastSpeechActivityAt = Date.now();
        speakCurrentChunk();
      }

      // Chrome mobile workaround: speech se pausa silenciosamente tras ~15s
      // Play - speakVerse DEBE llamarse sincronamente desde el click (user gesture)
      playBtn.addEventListener("click", function () {
        if (!window.speechSynthesis || verses.length === 0) return;

        window.speechSynthesis.cancel();
        currentIndex = 0;
        isPlaying = true;
        isPausedManually = false;
        updateButtons();
        acquireWakeLock();
        speakVerse(0);
        startRecoveryTimers();
      });

      function togglePauseResume() {
        if (
          window.speechSynthesis &&
          window.speechSynthesis.speaking &&
          !isPausedManually
        ) {
          window.speechSynthesis.pause();
          isPausedManually = true;
          updateButtons();
          releaseWakeLock();
        } else if (window.speechSynthesis && isPausedManually) {
          window.speechSynthesis.resume();
          isPausedManually = false;
          updateButtons();
          acquireWakeLock();
        }
      }

      function stopChapter() {
        if (window.speechSynthesis) {
          window.speechSynthesis.cancel();
        }
        isPlaying = false;
        isPausedManually = false;
        currentIndex = 0;
        clearHighlight();
        updateButtons();
        stopRecoveryTimers();
        releaseWakeLock();
        if (progressContainer) progressContainer.classList.add("hidden");
      }

      // Pause/Resume (toggle) / Stop
      toggleBtn.addEventListener("click", togglePauseResume);
      stopBtn.addEventListener("click", stopChapter);
      stickyToggleBtn?.addEventListener("click", togglePauseResume);
      stickyStopBtn?.addEventListener("click", stopChapter);

      // Escuchar evento de lectura de un verso individual
      window.addEventListener("verse-speech-started", function () {
        if (window.speechSynthesis) window.speechSynthesis.cancel();
        isPlaying = false;
        isPausedManually = false;
        currentIndex = 0;
        clearHighlight();
        updateButtons();
        stopRecoveryTimers();
        releaseWakeLock();
        if (progressContainer) progressContainer.classList.add("hidden");
      });

      document.addEventListener("visibilitychange", function () {
        if (!isPlaying || isPausedManually) return;
        if (document.visibilityState === "visible") {
          acquireWakeLock();
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initControls);
    } else {
      initControls();
    }
  })();
</script>

<style is:global>
  .chapter-sticky-player {
    padding-bottom: max(0.25rem, env(safe-area-inset-bottom));
  }

  .verse-highlight {
    background-color: rgba(34, 197, 94, 0.15);
    border-left: 4px solid #22c55e;
    padding-left: 0.75rem;
    margin-left: -1rem;
    border-radius: 0.25rem;
    transition: all 0.3s ease;
  }

  .dark .verse-highlight {
    background-color: rgba(34, 197, 94, 0.1);
    border-left-color: #4ade80;
  }

  .speed-slider {
    --speed-progress: 26.67%;
    border: 0;
    outline: none;
    background: linear-gradient(
      to right,
      #2563eb 0%,
      #2563eb var(--speed-progress),
      #e5e7eb var(--speed-progress),
      #e5e7eb 100%
    );
    box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.14);
  }

  .dark .speed-slider {
    background: linear-gradient(
      to right,
      #3b82f6 0%,
      #3b82f6 var(--speed-progress),
      #334155 var(--speed-progress),
      #334155 100%
    );
    box-shadow: inset 0 0 0 1px rgba(59, 130, 246, 0.26);
  }

  .speed-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 1rem;
    height: 1rem;
    border-radius: 9999px;
    background: #2563eb;
    border: 2px solid #f8fafc;
    box-shadow: 0 2px 10px rgba(37, 99, 235, 0.4);
    transition: transform 0.15s ease;
  }

  .speed-slider::-webkit-slider-thumb:hover {
    transform: scale(1.08);
  }

  .speed-slider::-moz-range-thumb {
    width: 1rem;
    height: 1rem;
    border-radius: 9999px;
    background: #2563eb;
    border: 2px solid #f8fafc;
    box-shadow: 0 2px 10px rgba(37, 99, 235, 0.4);
    transition: transform 0.15s ease;
  }

  .speed-slider::-moz-range-thumb:hover {
    transform: scale(1.08);
  }
</style>
