---
// Componente de lectura de capítulo completo - versículo por versículo
// Con highlight, auto-scroll, progreso, y control de velocidad
interface Props {
  versiculos: { numero: number; texto: string; titulo?: string }[];
  label?: string;
}

const { versiculos, label = "Leer capítulo completo" } = Astro.props;
const uniqueId = `chapter-${Date.now()}-${Math.random().toString(36).substring(2, 11)}`;
const versiculosJSON = JSON.stringify(versiculos);
---

<div class="space-y-4" id={`controls-${uniqueId}`}>
  <!-- Controles principales -->
  <div class="inline-flex gap-3 flex-wrap items-center">
    <button
      type="button"
      class="btn-play-chapter inline-flex items-center gap-2 px-8 py-4 bg-green-600 text-white rounded-lg hover:bg-green-700 focus:ring-4 focus:ring-green-300 transition-colors font-semibold text-xl shadow-lg"
      id={`play-${uniqueId}`}
      aria-label={label}
    >
      <span class="text-3xl" aria-hidden="true">▶️</span>
      <span>{label}</span>
    </button>

    <button
      type="button"
      class="btn-pause-chapter hidden items-center gap-2 px-8 py-4 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 focus:ring-4 focus:ring-yellow-300 transition-colors font-semibold text-xl shadow-lg"
      id={`pause-${uniqueId}`}
      aria-label="Pausar"
    >
      <span class="text-3xl" aria-hidden="true">⏸️</span>
      <span>Pausar</span>
    </button>

    <button
      type="button"
      class="btn-resume-chapter hidden items-center gap-2 px-8 py-4 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors font-semibold text-xl shadow-lg"
      id={`resume-${uniqueId}`}
      aria-label="Continuar"
    >
      <span class="text-3xl" aria-hidden="true">▶️</span>
      <span>Continuar</span>
    </button>

    <button
      type="button"
      class="btn-stop-chapter hidden items-center gap-2 px-8 py-4 bg-red-600 text-white rounded-lg hover:bg-red-700 focus:ring-4 focus:ring-red-300 transition-colors font-semibold text-xl shadow-lg"
      id={`stop-${uniqueId}`}
      aria-label="Detener"
    >
      <span class="text-3xl" aria-hidden="true">⏹️</span>
      <span>Detener</span>
    </button>
  </div>

  <!-- Control de velocidad -->
  <div class="flex items-center gap-3 flex-wrap">
    <label
      for={`speed-${uniqueId}`}
      class="text-sm font-semibold text-gray-700 dark:text-gray-300"
    >
      Velocidad:
    </label>
    <input
      type="range"
      id={`speed-${uniqueId}`}
      min="0.5"
      max="2.0"
      step="0.1"
      class="w-32 h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-blue-600"
      aria-label="Velocidad de lectura"
    />
    <span
      id={`speed-label-${uniqueId}`}
      class="text-sm font-mono text-gray-600 dark:text-gray-400 min-w-12"
      >0.9x</span
    >
  </div>

  <!-- Barra de progreso -->
  <div id={`progress-${uniqueId}`} class="hidden">
    <div class="flex items-center gap-3">
      <div
        class="flex-1 bg-gray-200 dark:bg-gray-700 rounded-full h-3 overflow-hidden"
      >
        <div
          id={`progress-bar-${uniqueId}`}
          class="bg-green-500 h-3 rounded-full transition-all duration-300"
          style="width: 0%"
        >
        </div>
      </div>
      <span
        id={`progress-text-${uniqueId}`}
        class="text-sm font-semibold text-gray-600 dark:text-gray-400 min-w-20 text-right"
      >
        0 / 0
      </span>
    </div>
  </div>

  <!-- Tip recomendando Edge -->
  <p class="text-xs text-gray-400 dark:text-gray-500 italic">
    💡 Para mejor calidad de voz, usa Microsoft Edge
  </p>
</div>

<script is:inline data-astro-rerun define:vars={{ uniqueId, versiculosJSON }}>
  (function () {
    var controlsId = uniqueId;
    var verses = JSON.parse(versiculosJSON);

    // Preferencias
    var RATE_KEY = "biblia-speech-rate";
    var VOICE_KEY = "biblia-voice-name";

    function getSavedRate() {
      try {
        return parseFloat(localStorage.getItem(RATE_KEY)) || 0.9;
      } catch (e) {
        return 0.9;
      }
    }

    function saveRate(r) {
      try {
        localStorage.setItem(RATE_KEY, r.toString());
      } catch (e) {}
    }

    function getSavedVoiceName() {
      try {
        return localStorage.getItem(VOICE_KEY);
      } catch (e) {
        return null;
      }
    }

    function getBestVoice() {
      var allVoices = window.speechSynthesis.getVoices();
      var spanish = allVoices.filter(function (v) {
        return v.lang.indexOf("es") === 0;
      });
      if (spanish.length === 0) return null;

      var savedName = getSavedVoiceName();
      if (savedName) {
        var saved = spanish.find(function (v) {
          return v.name === savedName;
        });
        if (saved) return saved;
      }

      var keywords = [
        "Neural",
        "Google",
        "Mónica",
        "Paulina",
        "Jorge",
        "Microsoft",
      ];
      for (var i = 0; i < keywords.length; i++) {
        var match = spanish.find(function (v) {
          return v.name.indexOf(keywords[i]) >= 0;
        });
        if (match) return match;
      }
      return spanish[0];
    }

    function initControls() {
      var playBtn = document.getElementById("play-" + controlsId);
      var pauseBtn = document.getElementById("pause-" + controlsId);
      var resumeBtn = document.getElementById("resume-" + controlsId);
      var stopBtn = document.getElementById("stop-" + controlsId);
      var speedSlider = document.getElementById("speed-" + controlsId);
      var speedLabel = document.getElementById("speed-label-" + controlsId);
      var progressContainer = document.getElementById("progress-" + controlsId);
      var progressBar = document.getElementById("progress-bar-" + controlsId);
      var progressText = document.getElementById("progress-text-" + controlsId);

      if (!playBtn) return;

      var currentVerseIndex = 0;
      var isPlaying = false;
      var isPausedManually = false;

      // Inicializar slider de velocidad
      var currentRate = getSavedRate();
      if (speedSlider) {
        speedSlider.value = currentRate.toString();
        speedLabel.textContent = currentRate.toFixed(1) + "x";
        speedSlider.addEventListener("input", function () {
          currentRate = parseFloat(speedSlider.value);
          speedLabel.textContent = currentRate.toFixed(1) + "x";
          saveRate(currentRate);
        });
      }

      function updateButtons() {
        if (isPlaying && !isPausedManually) {
          playBtn.classList.add("hidden");
          pauseBtn.classList.remove("hidden");
          pauseBtn.classList.add("inline-flex");
          resumeBtn.classList.add("hidden");
          resumeBtn.classList.remove("inline-flex");
          stopBtn.classList.remove("hidden");
          stopBtn.classList.add("inline-flex");
        } else if (isPausedManually) {
          playBtn.classList.add("hidden");
          pauseBtn.classList.add("hidden");
          pauseBtn.classList.remove("inline-flex");
          resumeBtn.classList.remove("hidden");
          resumeBtn.classList.add("inline-flex");
          stopBtn.classList.remove("hidden");
          stopBtn.classList.add("inline-flex");
        } else {
          playBtn.classList.remove("hidden");
          pauseBtn.classList.add("hidden");
          pauseBtn.classList.remove("inline-flex");
          resumeBtn.classList.add("hidden");
          resumeBtn.classList.remove("inline-flex");
          stopBtn.classList.add("hidden");
          stopBtn.classList.remove("inline-flex");
        }
      }

      function updateProgress(index, total) {
        if (!progressContainer || !progressBar || !progressText) return;
        progressContainer.classList.remove("hidden");
        var pct = total > 0 ? ((index + 1) / total) * 100 : 0;
        progressBar.style.width = pct + "%";
        progressText.textContent = index + 1 + " / " + total;
      }

      function highlightVerse(verseNum) {
        // Quitar highlight anterior
        var prevHL = document.querySelectorAll(".verse-highlight");
        prevHL.forEach(function (el) {
          el.classList.remove("verse-highlight");
        });

        // Agregar highlight al versículo actual
        var verseEl = document.getElementById("v" + verseNum);
        if (verseEl) {
          verseEl.classList.add("verse-highlight");
          // Auto-scroll suave
          verseEl.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      }

      function clearHighlight() {
        var highlighted = document.querySelectorAll(".verse-highlight");
        highlighted.forEach(function (el) {
          el.classList.remove("verse-highlight");
        });
      }

      function speakVerse(index) {
        if (!isPlaying || index >= verses.length) {
          // Terminó la lectura
          isPlaying = false;
          isPausedManually = false;
          clearHighlight();
          updateButtons();
          if (progressContainer) {
            setTimeout(function () {
              progressContainer.classList.add("hidden");
            }, 2000);
          }
          return;
        }

        currentVerseIndex = index;
        var verse = verses[index];
        highlightVerse(verse.numero);
        updateProgress(index, verses.length);

        var utterance = new SpeechSynthesisUtterance(verse.texto);
        utterance.lang = "es-ES";
        utterance.rate = currentRate;
        utterance.pitch = 1.0;
        utterance.volume = 1.0;

        var voice = getBestVoice();
        if (voice) {
          utterance.voice = voice;
          utterance.lang = voice.lang;
        }

        utterance.onend = function () {
          speakVerse(index + 1);
        };

        utterance.onerror = function (ev) {
          if (ev.error !== "interrupted" && ev.error !== "canceled") {
            speakVerse(index + 1);
          }
        };

        window.speechSynthesis.speak(utterance);
      }

      // Play
      playBtn.addEventListener("click", function () {
        if (!window.speechSynthesis || verses.length === 0) return;

        window.speechSynthesis.cancel();
        currentVerseIndex = 0;
        isPlaying = true;
        isPausedManually = false;
        updateButtons();
        speakVerse(0);
      });

      // Pause
      pauseBtn.addEventListener("click", function () {
        if (
          window.speechSynthesis &&
          window.speechSynthesis.speaking &&
          !isPausedManually
        ) {
          window.speechSynthesis.pause();
          isPausedManually = true;
          updateButtons();
        }
      });

      // Resume
      resumeBtn.addEventListener("click", function () {
        if (window.speechSynthesis && isPausedManually) {
          window.speechSynthesis.resume();
          isPausedManually = false;
          updateButtons();
        }
      });

      // Stop
      stopBtn.addEventListener("click", function () {
        if (window.speechSynthesis) {
          window.speechSynthesis.cancel();
        }
        isPlaying = false;
        isPausedManually = false;
        currentVerseIndex = 0;
        clearHighlight();
        updateButtons();
        if (progressContainer) progressContainer.classList.add("hidden");
      });

      // Escuchar evento de lectura de un verso individual
      window.addEventListener("verse-speech-started", function () {
        if (window.speechSynthesis) window.speechSynthesis.cancel();
        isPlaying = false;
        isPausedManually = false;
        currentVerseIndex = 0;
        clearHighlight();
        updateButtons();
        if (progressContainer) progressContainer.classList.add("hidden");
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initControls);
    } else {
      initControls();
    }
  })();
</script>

<style is:global>
  .verse-highlight {
    background-color: rgba(34, 197, 94, 0.15);
    border-left: 4px solid #22c55e;
    padding-left: 0.75rem;
    margin-left: -1rem;
    border-radius: 0.25rem;
    transition: all 0.3s ease;
  }

  .dark .verse-highlight {
    background-color: rgba(34, 197, 94, 0.1);
    border-left-color: #4ade80;
  }
</style>
