---
interface Props {
  libro: string;
  capitulo: number;
  versiculo: number;
  texto: string;
}

const { libro, capitulo, versiculo, texto } = Astro.props;
const shareData = JSON.stringify({ libro, capitulo, versiculo, texto });
---

<button
  type="button"
  class="btn-share inline-flex items-center gap-1 px-3 py-1.5 text-sm bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-lg hover:bg-purple-200 dark:hover:bg-purple-800/40 focus:ring-2 focus:ring-purple-300 transition-colors font-semibold"
  data-share={shareData}
  aria-label={`Compartir ${libro} ${capitulo}:${versiculo}`}
>
  <span aria-hidden="true">&#128279;</span>
  <span>Compartir</span>
</button>

<script>
  type ShareWindow = Window & { __bibliaShareDelegated?: boolean };

  function slugifyBookName(name: string): string {
    return name
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-zA-Z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .toLowerCase();
  }

  function initShareButtons() {
    const win = window as ShareWindow;
    if (win.__bibliaShareDelegated) return;
    win.__bibliaShareDelegated = true;

    document.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const btn = target.closest(".btn-share") as HTMLButtonElement | null;
      if (!btn) return;

      const raw = btn.dataset.share;
      if (!raw) return;

      const data = JSON.parse(raw) as {
        libro: string;
        capitulo: number;
        versiculo: number;
        texto: string;
      };

      const url = `${window.location.origin}/libro/${slugifyBookName(data.libro)}/${data.capitulo}#v${data.versiculo}`;
      const shareText = `"${data.texto}" - ${data.libro} ${data.capitulo}:${data.versiculo}`;

      if (navigator.share) {
        try {
          await navigator.share({
            title: `${data.libro} ${data.capitulo}:${data.versiculo}`,
            text: shareText,
            url,
          });
          return;
        } catch {
          // fallback a copiar
        }
      }

      try {
        await navigator.clipboard.writeText(`${shareText}\n${url}`);
        const originalHTML = btn.innerHTML;
        btn.innerHTML = '<span aria-hidden="true">&#9989;</span> <span>Copiado</span>';
        btn.classList.add("bg-green-100", "text-green-700");
        setTimeout(() => {
          btn.innerHTML = originalHTML;
          btn.classList.remove("bg-green-100", "text-green-700");
        }, 2000);
      } catch {
        prompt("Copia este enlace:", `${shareText}\n${url}`);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initShareButtons);
  } else {
    initShareButtons();
  }
</script>
