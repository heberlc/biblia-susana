---
interface Props {
  text: string;
  label?: string;
  className?: string;
}

const { text, label = "Leer" } = Astro.props;
const uniqueId = `speech-${Date.now()}-${Math.random().toString(36).substring(2, 11)}`;
---

<div class="flex flex-col gap-2">
  <button
    type="button"
    class="btn-speech inline-flex items-center gap-2 px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 focus:ring-4 focus:ring-green-300 transition-colors font-semibold text-lg"
    data-text={text}
    data-speech-id={uniqueId}
    aria-label={`${label}: ${text.substring(0, 50)}...`}
  >
    <span class="text-2xl" aria-hidden="true">&#128266;</span>
    <span>{label}</span>
  </button>

  <button
    type="button"
    class="btn-stop-speech hidden items-center gap-2 px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 focus:ring-4 focus:ring-red-300 transition-colors font-semibold text-lg"
    data-speech-id={uniqueId}
    aria-label="Detener audio"
  >
    <span class="text-2xl" aria-hidden="true">&#9209;</span>
    <span>Detener</span>
  </button>
</div>

<script>
  import { speechRead, speechStop, initSpeech, isSpeaking } from "../lib/speech";

  type WindowWithSpeechState = Window & {
    __bibliaSpeechDelegated?: boolean;
    __bibliaSpeechActiveId?: string | null;
  };

  function getWin(): WindowWithSpeechState {
    return window as WindowWithSpeechState;
  }

  function updateButtons(activeSpeechId: string | null) {
    const speaking = isSpeaking();
    const allStopButtons = document.querySelectorAll(".btn-stop-speech");

    allStopButtons.forEach((btn) => {
      const btnId = btn.getAttribute("data-speech-id");
      if (speaking && btnId === activeSpeechId) {
        btn.classList.remove("hidden");
        btn.classList.add("inline-flex");
      } else {
        btn.classList.add("hidden");
        btn.classList.remove("inline-flex");
      }
    });
  }

  function resetChapterButtons() {
    speechStop();

    const chapterControls = document.querySelectorAll('[id^="controls-chapter-"]');
    chapterControls.forEach((container) => {
      const playBtn = container.querySelector(".btn-play-chapter");
      const pauseBtn = container.querySelector(".btn-pause-chapter");
      const resumeBtn = container.querySelector(".btn-resume-chapter");
      const stopBtn = container.querySelector(".btn-stop-chapter");

      playBtn?.classList.remove("hidden");
      pauseBtn?.classList.add("hidden");
      resumeBtn?.classList.add("hidden");
      stopBtn?.classList.add("hidden");
    });

    window.dispatchEvent(new CustomEvent("verse-speech-started"));
  }

  function initDelegatedSpeechButtons() {
    const win = getWin();
    if (win.__bibliaSpeechDelegated) return;

    initSpeech();
    win.__bibliaSpeechDelegated = true;
    win.__bibliaSpeechActiveId = null;

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const stopButton = target.closest(".btn-stop-speech") as HTMLButtonElement | null;
      if (stopButton) {
        speechStop();
        win.__bibliaSpeechActiveId = null;
        updateButtons(null);
        return;
      }

      const playButton = target.closest(".btn-speech") as HTMLButtonElement | null;
      if (!playButton) return;

      const text = playButton.dataset.text || playButton.getAttribute("data-text");
      const speechId = playButton.getAttribute("data-speech-id");
      if (!text || !speechId) return;

      resetChapterButtons();
      window.speechSynthesis?.cancel();
      win.__bibliaSpeechActiveId = speechId;

      speechRead(text, () => {
        win.__bibliaSpeechActiveId = null;
        updateButtons(null);
      });

      updateButtons(win.__bibliaSpeechActiveId);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDelegatedSpeechButtons);
  } else {
    initDelegatedSpeechButtons();
  }
</script>
