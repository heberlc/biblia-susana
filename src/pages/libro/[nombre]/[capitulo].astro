---
import Layout from "../../../layouts/Layout.astro";
import SpeechButton from "../../../components/SpeechButton.astro";
import ChapterSpeechButton from "../../../components/ChapterSpeechButton.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ShareButton from "../../../components/ShareButton.astro";
import { loadBible } from "../../../lib/loadBible";
import { slugifyBookName } from "../../../lib/bookSlug";
import type { Libro, Capitulo } from "../../../types/bible";

function normalizeBookName(value: string): string {
  return value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();
}

export async function getStaticPaths() {
  const biblia = await loadBible();
  const paths: { params: { nombre: string; capitulo: string } }[] = [];
  const seen = new Set<string>();

  for (const libro of biblia.libros) {
    const bookCandidates = [slugifyBookName(libro.nombre), libro.nombre];
    for (const bookParam of bookCandidates) {
      if (!bookParam) continue;
      for (const capitulo of libro.capitulos) {
        const key = `${bookParam}::${capitulo.numero}`;
        if (seen.has(key)) continue;
        seen.add(key);
        paths.push({
          params: {
            nombre: bookParam,
            capitulo: capitulo.numero.toString(),
          },
        });
      }
    }
  }

  return paths;
}

const { nombre, capitulo: capituloNumStr } = Astro.params;
const rawNombre = nombre ?? "";
const decodedNombre = decodeURIComponent(rawNombre);
const normalizedParam = normalizeBookName(decodedNombre);
const capituloNum = parseInt(capituloNumStr || "1", 10);

let libro: Libro | undefined;
let capitulo: Capitulo | undefined;
let error = false;

try {
  const biblia = await loadBible();
  libro = biblia.libros.find((l) => {
    const normalizedLibro = normalizeBookName(l.nombre);
    const libroSlug = slugifyBookName(l.nombre);
    return (
      libroSlug === rawNombre ||
      libroSlug === decodedNombre ||
      l.nombre === rawNombre ||
      l.nombre === decodedNombre ||
      normalizedLibro === normalizedParam
    );
  });
  if (libro) {
    capitulo = libro.capitulos.find((c) => c.numero === capituloNum);
  }
} catch (e) {
  console.error("Error al cargar el capitulo:", e);
  error = true;
}

if ((!libro || !capitulo) && !error) {
  return Astro.redirect("/404");
}

const capituloAnterior = libro && capituloNum > 1 ? capituloNum - 1 : null;
const capituloSiguiente = libro && capituloNum < libro.capitulos.length ? capituloNum + 1 : null;
const libroSlug = libro ? slugifyBookName(libro.nombre) : "";

const totalVerses = capitulo?.versiculos.length ?? 0;
const lazyThreshold = 80;
const lazyChunkSize = 24;
const hasLazyLoad = Boolean(capitulo && totalVerses > lazyThreshold);
const initialVerseCount = hasLazyLoad ? 40 : totalVerses;
const versiculosIniciales = capitulo ? capitulo.versiculos.slice(0, initialVerseCount) : [];
const versiculosRestantes = capitulo ? capitulo.versiculos.slice(initialVerseCount) : [];
const versiculosRestantesJSON = JSON.stringify(versiculosRestantes);
---

<Layout
  title={`${libro?.nombre} ${capituloNum} - Biblia Susana`}
  description={`${libro?.nombre} capitulo ${capituloNum} - Lee versiculo por versiculo con audio. Biblia Susana`}
>
  <div class="max-w-4xl mx-auto">
    <Breadcrumbs
      items={[
        { label: libro?.nombre || "", href: `/libro/${libroSlug}` },
        { label: `Capitulo ${capituloNum}` },
      ]}
    />

    {error && (
      <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-6 rounded-lg" role="alert">
        <p class="font-bold text-xl mb-2">Error al cargar el capitulo</p>
        <p class="text-lg">No se pudo cargar el contenido. Intenta de nuevo.</p>
      </div>
    )}

    {libro && capitulo && (
      <div>
        <header class="mb-8 text-center bg-blue-50/80 dark:bg-gray-800 rounded-xl p-6 border-2 border-blue-200 dark:border-blue-800 shadow-md">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-800 dark:text-gray-100 mb-2">
            {libro.nombre} {capituloNum}
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300">
            {capitulo.versiculos.length} {capitulo.versiculos.length === 1 ? "versiculo" : "versiculos"}
          </p>
        </header>

        <div class="mb-8 flex justify-center">
          <ChapterSpeechButton
            versiculos={capitulo.versiculos.map((v) => ({ numero: v.numero, texto: v.texto, titulo: v.titulo }))}
            label="Leer capitulo completo"
          />
        </div>

        <section class="space-y-6 mb-8" id="verses-section">
          <h2 class="sr-only">Versiculos</h2>
          {versiculosIniciales.map((versiculo) => (
            <article
              id={`v${versiculo.numero}`}
              class="verse-item bg-white/95 dark:bg-gray-800 rounded-xl shadow-md p-6 hover:shadow-lg transition-shadow border-l-4 border-blue-500 dark:border-blue-400"
            >
              {versiculo.titulo && (
                <h3 class="text-2xl font-bold text-blue-700 dark:text-blue-400 mb-4 border-b-2 border-blue-200 dark:border-blue-700 pb-2">
                  {versiculo.titulo}
                </h3>
              )}
              <div class="flex items-start gap-4">
                <span
                  class="shrink-0 w-12 h-12 bg-blue-600 dark:bg-blue-700 text-white rounded-full flex items-center justify-center text-xl font-bold"
                  aria-label={`Versiculo ${versiculo.numero}`}
                >
                  {versiculo.numero}
                </span>
                <div class="flex-1">
                  <p class="text-xl text-gray-800 dark:text-gray-200 leading-relaxed mb-4">{versiculo.texto}</p>
                  <div class="flex flex-wrap gap-2">
                    <SpeechButton
                      text={`${versiculo.titulo ? versiculo.titulo + ". " : ""}${libro.nombre} ${capituloNum} ${versiculo.numero}. ${versiculo.texto}`}
                      label="Escuchar"
                    />
                    <ShareButton
                      libro={libro.nombre}
                      capitulo={capituloNum}
                      versiculo={versiculo.numero}
                      texto={versiculo.texto}
                    />
                  </div>
                </div>
              </div>
            </article>
          ))}

          <div id="lazy-verses-root" class="space-y-6"></div>
        </section>

        {hasLazyLoad && (
          <div class="mb-12 text-center">
            <button
              id="load-more-verses"
              type="button"
              class="inline-flex items-center gap-2 px-8 py-4 bg-amber-600 text-white rounded-lg hover:bg-amber-700 focus:ring-4 focus:ring-amber-300 transition-colors shadow-lg font-semibold"
            >
              <span aria-hidden="true">&#128220;</span>
              Cargar mas versiculos
            </button>
            <p id="lazy-progress" class="mt-3 text-sm text-gray-600 dark:text-gray-400">
              Mostrando {initialVerseCount} de {totalVerses} versiculos
            </p>
          </div>
        )}

        <nav class="flex justify-between items-center gap-4 py-8 border-t-2 border-gray-200" aria-label="Navegacion entre capitulos">
          {capituloAnterior ? (
            <a
              href={`/libro/${libroSlug}/${capituloAnterior}`}
              class="btn-large inline-flex items-center gap-2 px-8 py-4 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors shadow-lg"
            >
              <span class="text-2xl" aria-hidden="true">&#11013;</span>
              <span class="hidden sm:inline">Capitulo {capituloAnterior}</span>
              <span class="sm:hidden">Anterior</span>
            </a>
          ) : (
            <div></div>
          )}

          {capituloSiguiente ? (
            <a
              href={`/libro/${libroSlug}/${capituloSiguiente}`}
              class="btn-large inline-flex items-center gap-2 px-8 py-4 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors shadow-lg"
            >
              <span class="hidden sm:inline">Capitulo {capituloSiguiente}</span>
              <span class="sm:hidden">Siguiente</span>
              <span class="text-2xl" aria-hidden="true">&#10145;</span>
            </a>
          ) : (
            <div></div>
          )}
        </nav>
      </div>
    )}
  </div>
</Layout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .verse-item {
      animation: slideUp 0.35s ease-out;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  .verse-highlight {
    animation: highlight 2s ease-in-out;
  }

  @keyframes highlight {
    0%,
    100% {
      background-color: transparent;
    }
    50% {
      background-color: rgba(59, 130, 246, 0.2);
    }
  }
</style>

<script is:inline define:vars={{
  libroNombre: libro?.nombre || "",
  capituloNumero: capituloNum,
  hasLazyLoad,
  initialVerseCount,
  totalVerses,
  lazyChunkSize,
  versiculosRestantesJSON,
}}>
  try {
    const progress = {
      libro: libroNombre,
      capitulo: capituloNumero,
      url: window.location.pathname,
      timestamp: Date.now(),
    };
    localStorage.setItem("biblia-reading-progress", JSON.stringify(progress));
  } catch {}

  function escapeHtml(value) {
    return (value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/\"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function renderLazyVerse(versiculo) {
    var speechId = "lazy-" + versiculo.numero + "-" + Math.random().toString(36).slice(2, 9);
    var textForSpeech =
      (versiculo.titulo ? versiculo.titulo + ". " : "") +
      libroNombre +
      " " +
      capituloNumero +
      " " +
      versiculo.numero +
      ". " +
      versiculo.texto;

    var sharePayload = JSON.stringify({
      libro: libroNombre,
      capitulo: capituloNumero,
      versiculo: versiculo.numero,
      texto: versiculo.texto,
    });

    return `
      <article id="v${versiculo.numero}" class="verse-item bg-white/95 dark:bg-gray-800 rounded-xl shadow-md p-6 hover:shadow-lg transition-shadow border-l-4 border-blue-500 dark:border-blue-400">
        ${
          versiculo.titulo
            ? `<h3 class="text-2xl font-bold text-blue-700 dark:text-blue-400 mb-4 border-b-2 border-blue-200 dark:border-blue-700 pb-2">${escapeHtml(versiculo.titulo)}</h3>`
            : ""
        }
        <div class="flex items-start gap-4">
          <span class="shrink-0 w-12 h-12 bg-blue-600 dark:bg-blue-700 text-white rounded-full flex items-center justify-center text-xl font-bold" aria-label="Versiculo ${versiculo.numero}">${versiculo.numero}</span>
          <div class="flex-1">
            <p class="text-xl text-gray-800 dark:text-gray-200 leading-relaxed mb-4">${escapeHtml(versiculo.texto)}</p>
            <div class="flex flex-wrap gap-2">
              <div class="flex flex-col gap-2">
                <button type="button" class="btn-speech inline-flex items-center gap-2 px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 focus:ring-4 focus:ring-green-300 transition-colors font-semibold text-lg" data-text="${escapeHtml(textForSpeech)}" data-speech-id="${speechId}" aria-label="Escuchar versiculo ${versiculo.numero}">
                  <span class="text-2xl" aria-hidden="true">&#128266;</span>
                  <span>Escuchar</span>
                </button>
                <button type="button" class="btn-stop-speech hidden items-center gap-2 px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 focus:ring-4 focus:ring-red-300 transition-colors font-semibold text-lg" data-speech-id="${speechId}" aria-label="Detener audio">
                  <span class="text-2xl" aria-hidden="true">&#9209;</span>
                  <span>Detener</span>
                </button>
              </div>
              <button type="button" class="btn-share inline-flex items-center gap-1 px-3 py-1.5 text-sm bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-lg hover:bg-purple-200 dark:hover:bg-purple-800/40 focus:ring-2 focus:ring-purple-300 transition-colors font-semibold" data-share='${escapeHtml(sharePayload)}' aria-label="Compartir ${libroNombre} ${capituloNumero}:${versiculo.numero}">
                <span aria-hidden="true">&#128279;</span>
                <span>Compartir</span>
              </button>
            </div>
          </div>
        </div>
      </article>
    `;
  }

  var lazyRoot = document.getElementById("lazy-verses-root");
  var loadMoreBtn = document.getElementById("load-more-verses");
  var progress = document.getElementById("lazy-progress");
  var remainingVerses = hasLazyLoad ? JSON.parse(versiculosRestantesJSON || "[]") : [];
  var lazyPointer = 0;

  function updateLazyProgress() {
    if (!progress) return;
    var loaded = initialVerseCount + lazyPointer;
    progress.textContent = "Mostrando " + loaded + " de " + totalVerses + " versiculos";
  }

  function appendLazyChunk(size) {
    if (!hasLazyLoad || !lazyRoot) return;
    var limit = Math.min(lazyPointer + size, remainingVerses.length);
    if (lazyPointer >= limit) return;

    var html = "";
    for (var i = lazyPointer; i < limit; i++) {
      html += renderLazyVerse(remainingVerses[i]);
    }
    lazyRoot.insertAdjacentHTML("beforeend", html);
    lazyPointer = limit;
    updateLazyProgress();

    if (loadMoreBtn && lazyPointer >= remainingVerses.length) {
      loadMoreBtn.classList.add("hidden");
    }
  }

  if (loadMoreBtn && hasLazyLoad) {
    loadMoreBtn.addEventListener("click", function () {
      appendLazyChunk(lazyChunkSize);
    });
  }

  function ensureHashTargetLoadedAndScroll() {
    if (!window.location.hash) return;
    var match = window.location.hash.match(/^#v(\d+)$/);
    if (!match) return;

    var targetVerse = parseInt(match[1], 10);
    if (!targetVerse || isNaN(targetVerse)) return;

    if (hasLazyLoad && targetVerse > initialVerseCount) {
      while (initialVerseCount + lazyPointer < targetVerse && lazyPointer < remainingVerses.length) {
        appendLazyChunk(lazyChunkSize);
      }
    }

    var element = document.querySelector(window.location.hash);
    if (!element) return;

    setTimeout(function () {
      element.scrollIntoView({ behavior: "smooth", block: "center" });
      element.classList.add("verse-highlight");
      setTimeout(function () {
        element.classList.remove("verse-highlight");
      }, 2000);
    }, 100);
  }

  ensureHashTargetLoadedAndScroll();
</script>
