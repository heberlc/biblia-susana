---
import Layout from "../layouts/Layout.astro";
import LibroCard from "../components/LibroCard.astro";
import VoiceSearch from "../components/VoiceSearch.astro";
import ShareButton from "../components/ShareButton.astro";
import { loadBible } from "../lib/loadBible";
import type { Libro } from "../types/bible";

let libros: Libro[] = [];
let error = false;

// Versículo del día (determinístico según día del año)
interface VerseOfDay {
  libro: string;
  capitulo: number;
  versiculo: number;
  texto: string;
  titulo?: string;
}
let versiculoDelDia: VerseOfDay | null = null;

try {
  const biblia = await loadBible();
  libros = biblia.libros;

  // Recopilar todos los versículos
  const allVerses: VerseOfDay[] = [];
  for (const libro of biblia.libros) {
    for (const cap of libro.capitulos) {
      for (const v of cap.versiculos) {
        allVerses.push({
          libro: libro.nombre,
          capitulo: cap.numero,
          versiculo: v.numero,
          texto: v.texto,
          titulo: v.titulo,
        });
      }
    }
  }

  // Índice del día basado en día del año
  const now = new Date();
  const dayOfYear = Math.floor(
    (now.getTime() - new Date(now.getFullYear(), 0, 0).getTime()) / 86400000
  );
  versiculoDelDia = allVerses[dayOfYear % allVerses.length];
} catch (e) {
  console.error('Error al cargar la Biblia:', e);
  error = true;
}
---

<Layout
  title="Biblia Susana - Lee la Palabra de Dios"
  description="Biblia Susana: Lee y estudia la Biblia con herramientas accesibles. Búsqueda inteligente, lectura en voz alta de versículos y capítulos completos, diseño claro y fácil de usar"
>
  <div class="max-w-6xl mx-auto">
    <!-- Sección de búsqueda -->
    <section class="mb-12 text-center spacing-wide">
            <h2 class="text-4xl font-bold text-center mb-8 text-blue-800 dark:text-blue-400">
        Bienvenido a Biblia Susana
      </h2>
            <p class="text-xl text-center mb-12 text-gray-700 dark:text-gray-300 max-w-3xl mx-auto">
        Lee la Palabra de Dios con herramientas accesibles. Busca, escucha y explora las Escrituras de forma sencilla.
      </p>

      <!-- Formulario de búsqueda -->
      <form action="/buscar-client" method="get" class="mb-8">
        <div class="flex flex-col md:flex-row gap-4 max-w-3xl mx-auto">
          <label for="searchInput" class="sr-only">Buscar en la Biblia</label>
          <input
            type="search"
            id="searchInput"
            name="q"
            placeholder="Buscar (ej: amor, fe, Juan 3:16)"
            class="flex-1 px-6 py-4 text-xl border-2 border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 rounded-lg focus:border-blue-500 focus:ring-4 focus:ring-blue-300 transition-colors"
            required
          />
          <button
            type="submit"
            class="btn-large bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors shadow-lg px-8"
          >
            <span class="text-2xl mr-2" aria-hidden="true">🔍</span>
            Buscar
          </button>
        </div>
      </form>

      <!-- Búsqueda por voz -->
      <VoiceSearch className="mb-8" />
    </section>

    <!-- Mensaje de error -->
    {error && (
      <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-6 rounded-lg mb-8" role="alert">
        <p class="font-bold text-xl mb-2">Error al cargar la Biblia</p>
        <p class="text-lg">
          No se pudo cargar el contenido. Verifica que el archivo 
          <code class="bg-red-200 px-2 py-1 rounded">public/data/biblia.json</code> exista.
        </p>
      </div>
    )}

    <!-- Continuar leyendo -->
    <section id="continuar-leyendo" class="mb-10 hidden">
      <div class="bg-linear-to-r from-blue-50 to-purple-50 dark:from-gray-800 dark:to-gray-800 rounded-xl p-6 shadow-md border border-blue-200 dark:border-blue-800">
        <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100 mb-2">
          📖 Continuar leyendo
        </h3>
        <p class="text-gray-600 dark:text-gray-300 mb-4" id="progress-text"></p>
        <a
          id="progress-link"
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors font-semibold"
        >
          Continuar ➡️
        </a>
      </div>
    </section>

    <!-- Versículo del día -->
    {versiculoDelDia && (
      <section class="mb-10">
        <div class="bg-linear-to-r from-amber-50 to-yellow-50 dark:from-gray-800 dark:to-gray-800 rounded-xl p-6 shadow-md border border-amber-200 dark:border-amber-800">
          <h3 class="text-xl font-bold text-amber-700 dark:text-amber-400 mb-3">
            ✨ Versículo del día
          </h3>
          <blockquote class="text-lg text-gray-800 dark:text-gray-200 leading-relaxed italic mb-3">
            "{versiculoDelDia.texto}"
          </blockquote>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <a
              href={`/libro/${encodeURIComponent(versiculoDelDia.libro)}/${versiculoDelDia.capitulo}#v${versiculoDelDia.versiculo}`}
              class="font-bold text-amber-700 dark:text-amber-400 hover:underline"
            >
              — {versiculoDelDia.libro} {versiculoDelDia.capitulo}:{versiculoDelDia.versiculo}
            </a>
            <ShareButton
              libro={versiculoDelDia.libro}
              capitulo={versiculoDelDia.capitulo}
              versiculo={versiculoDelDia.versiculo}
              texto={versiculoDelDia.texto}
            />
          </div>
        </div>
      </section>
    )}

    <!-- Lista de libros -->
    {!error && libros.length > 0 && (
      <section>
        <h3 class="text-3xl font-bold mb-8 text-gray-800 dark:text-gray-100 text-center">
          Libros de la Biblia
        </h3>
        
        <!-- Pestañas -->
        <div class="mb-8">
          <div class="flex justify-center gap-4 flex-wrap" role="tablist" aria-label="Testamentos">
            <button
              id="tabAT"
              role="tab"
              aria-selected="true"
              aria-controls="contentAT"
              class="tab-button active px-8 py-3 text-lg font-bold rounded-lg transition-colors"
            >
              📜 Antiguo Testamento
            </button>
            <button
              id="tabNT"
              role="tab"
              aria-selected="false"
              aria-controls="contentNT"
              class="tab-button px-8 py-3 text-lg font-bold rounded-lg transition-colors"
            >
              ✝️ Nuevo Testamento
            </button>
          </div>
        </div>

        <!-- Antiguo Testamento -->
        <div id="contentAT" role="tabpanel" aria-labelledby="tabAT" class="tab-content">
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
            {libros.slice(0, 39).map((libro) => (
              <LibroCard
                nombre={libro.nombre}
                numCapitulos={libro.capitulos.length}
                href={`/libro/${encodeURIComponent(libro.nombre)}`}
              />
            ))}
          </div>
        </div>

        <!-- Nuevo Testamento -->
        <div id="contentNT" role="tabpanel" aria-labelledby="tabNT" class="tab-content hidden">
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
            {libros.slice(39).map((libro) => (
              <LibroCard
                nombre={libro.nombre}
                numCapitulos={libro.capitulos.length}
                href={`/libro/${encodeURIComponent(libro.nombre)}`}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </div>

  <script>
    // === Tabs ===
    const tabAT = document.getElementById('tabAT');
    const tabNT = document.getElementById('tabNT');
    const contentAT = document.getElementById('contentAT');
    const contentNT = document.getElementById('contentNT');

    function switchTab(showAT: boolean) {
      if (showAT) {
        tabAT?.classList.add('active');
        tabNT?.classList.remove('active');
        tabAT?.setAttribute('aria-selected', 'true');
        tabNT?.setAttribute('aria-selected', 'false');
        contentAT?.classList.remove('hidden');
        contentNT?.classList.add('hidden');
      } else {
        tabAT?.classList.remove('active');
        tabNT?.classList.add('active');
        tabAT?.setAttribute('aria-selected', 'false');
        tabNT?.setAttribute('aria-selected', 'true');
        contentAT?.classList.add('hidden');
        contentNT?.classList.remove('hidden');
      }
    }

    tabAT?.addEventListener('click', () => switchTab(true));
    tabNT?.addEventListener('click', () => switchTab(false));

    // === Continuar Leyendo (hidratación desde localStorage) ===
    try {
      const raw = localStorage.getItem('biblia-reading-progress');
      if (raw) {
        const progress = JSON.parse(raw) as { libro: string; capitulo: number; url: string };
        const section = document.getElementById('continuar-leyendo');
        const textEl = document.getElementById('progress-text');
        const linkEl = document.getElementById('progress-link') as HTMLAnchorElement | null;

        if (section && textEl && linkEl && progress.libro && progress.url) {
          textEl.textContent = `${progress.libro}, capítulo ${progress.capitulo}`;
          linkEl.href = progress.url;
          section.classList.remove('hidden');
        }
      }
    } catch { /* sin localStorage */ }

    // === Búsqueda por referencia directa (ej: "Juan 3:16") ===
    const searchForm = document.querySelector('form[action="/buscar-client"]');
    searchForm?.addEventListener('submit', (e) => {
      const input = searchForm.querySelector('input[name="q"]') as HTMLInputElement | null;
      if (!input) return;

      const query = input.value.trim();
      // Patrón: "Libro Cap:Vers" o "1 Juan 3:16"
      const refMatch = query.match(/^(\d?\s?[A-ZÁÉÍÓÚa-záéíóú]+(?:\s[A-ZÁÉÍÓÚa-záéíóú]+)*)\s+(\d+):(\d+)$/);
      if (refMatch) {
        e.preventDefault();
        const libro = refMatch[1].trim();
        const cap = refMatch[2];
        const vers = refMatch[3];
        window.location.href = `/libro/${encodeURIComponent(libro)}/${cap}#v${vers}`;
      }
    });
  </script>
</Layout>

<style>
  .tab-button {
    background: #e5e7eb;
    color: #374151;
  }

  .dark .tab-button {
    background: #374151;
    color: #e5e7eb;
  }

  .tab-button.active {
    background: #2563eb;
    color: white;
  }

  .dark .tab-button.active {
    background: #1e40af;
    color: white;
  }

  .tab-button:hover {
    opacity: 0.9;
  }

  /* Animación suave para las tarjetas (respeta prefers-reduced-motion) */
  @media (prefers-reduced-motion: no-preference) {
    .grid > * {
      animation: fadeIn 0.5s ease-in-out;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
