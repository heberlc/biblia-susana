---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Buscar Versiculos - Biblia Susana"
  description="Busca versiculos en toda la Biblia. Busqueda inteligente por texto, titulos y referencias biblicas"
>
  <div class="max-w-5xl mx-auto">
    <section class="mb-8">
      <form id="searchForm" class="mb-6">
        <div class="flex flex-col md:flex-row gap-4">
          <label for="searchInput" class="sr-only">Buscar en la Biblia</label>
          <input
            type="search"
            id="searchInput"
            name="q"
            placeholder="Buscar versiculos... (ej: amor, fe, esperanza)"
            class="flex-1 px-6 py-4 text-xl border-2 border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100 rounded-lg focus:border-blue-500 focus:ring-4 focus:ring-blue-300 transition-colors"
            required
            autofocus
          />
          <button
            type="submit"
            class="btn-large bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors shadow-lg px-8"
          >
            <span class="text-2xl mr-2" aria-hidden="true">&#128269;</span>
            Buscar
          </button>
        </div>
      </form>

      <div class="flex justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 transition-colors font-semibold text-lg"
        >
          <span class="text-xl" aria-hidden="true">&#127968;</span>
          Volver al Inicio
        </a>
      </div>
    </section>

    <div id="loading" class="hidden text-center py-12">
      <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      <p class="mt-4 text-xl text-gray-600 dark:text-gray-400">Buscando...</p>
    </div>

    <div id="results" class="hidden">
      <h2 id="resultsTitle" class="text-3xl font-bold mb-6 text-gray-800 dark:text-gray-100"></h2>
      <div id="resultsList" class="space-y-6"></div>
    </div>

    <div id="noResults" class="hidden bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-6 rounded-lg">
      <p class="font-bold text-xl mb-2">Sin resultados</p>
      <p class="text-lg">Intenta con otros terminos de busqueda o verifica la ortografia.</p>
    </div>

    <div id="initialMessage" class="bg-blue-100 border-l-4 border-blue-500 text-blue-700 p-6 rounded-lg text-center">
      <p class="font-bold text-xl mb-2">Busqueda en la Biblia</p>
      <p class="text-lg">Ingresa un termino para buscar en todos los versiculos de la Biblia.</p>
      <p class="text-sm mt-4 text-blue-600">Ejemplos: amor, fe, esperanza, paz, jesus</p>
    </div>
  </div>

  <script>
    import Fuse from "fuse.js";

    interface VersiculoIndexado {
      libro: string;
      capitulo: number;
      versiculo: number;
      titulo: string | null;
      texto: string;
    }

    interface SearchIndexPayload {
      docs: VersiculoIndexado[];
      index: any;
      options: {
        keys: string[];
        threshold: number;
        includeScore: boolean;
        minMatchCharLength: number;
        ignoreLocation: boolean;
      };
    }

    let fuseInstance: Fuse<VersiculoIndexado> | null = null;
    let searchReady = false;

    async function loadPrecomputedSearchIndex(): Promise<SearchIndexPayload> {
      const response = await fetch("/data/search-index.json");
      if (!response.ok) {
        throw new Error("No se pudo cargar search-index.json");
      }
      return await response.json();
    }

    function initializeSearch(payload: SearchIndexPayload) {
      const parsedIndex = Fuse.parseIndex<VersiculoIndexado>(payload.index);
      fuseInstance = new Fuse(payload.docs, payload.options, parsedIndex);
      searchReady = true;
    }

    function buscar(query: string): VersiculoIndexado[] {
      if (!searchReady || !fuseInstance || !query || query.trim().length < 2) {
        return [];
      }

      const resultados = fuseInstance.search(query);
      return resultados.map((r) => r.item);
    }

    function slugifyBookName(name: string): string {
      return name
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-zA-Z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .toLowerCase();
    }

    function displayResults(query: string, resultados: VersiculoIndexado[]) {
      const loading = document.getElementById("loading");
      const results = document.getElementById("results");
      const noResults = document.getElementById("noResults");
      const initialMessage = document.getElementById("initialMessage");
      const resultsTitle = document.getElementById("resultsTitle");
      const resultsList = document.getElementById("resultsList");

      loading?.classList.add("hidden");
      initialMessage?.classList.add("hidden");

      if (resultados.length === 0) {
        results?.classList.add("hidden");
        noResults?.classList.remove("hidden");
        return;
      }

      noResults?.classList.add("hidden");
      results?.classList.remove("hidden");

      if (resultsTitle) {
        resultsTitle.textContent = `${resultados.length} resultado${resultados.length !== 1 ? "s" : ""} para "${query}"`;
      }

      if (resultsList) {
        resultsList.innerHTML = resultados
          .map(
            (resultado: VersiculoIndexado) => `
        <article class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 hover:shadow-lg transition-shadow border-l-4 border-blue-500 dark:border-blue-400">
          ${
            resultado.titulo
              ? `
            <h3 class="text-lg font-bold text-blue-700 dark:text-blue-400 mb-2">
              ${resultado.titulo}
            </h3>
          `
              : ""
          }
          <header class="mb-4">
            <h3 class="text-xl font-bold text-blue-700 dark:text-blue-400">
              <a 
                href="/libro/${slugifyBookName(resultado.libro)}/${resultado.capitulo}#v${resultado.versiculo}"
                class="hover:underline focus:outline-none focus:ring-2 focus:ring-blue-500 rounded"
              >
                ${resultado.libro} ${resultado.capitulo}:${resultado.versiculo}
              </a>
            </h3>
          </header>

          <p class="text-lg text-gray-800 dark:text-gray-200 mb-4 leading-relaxed">
            ${resultado.texto}
          </p>

          <div class="flex gap-4">
            <a
              href="/libro/${slugifyBookName(resultado.libro)}/${resultado.capitulo}"
              class="inline-flex items-center gap-2 px-4 py-2 bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 focus:ring-4 focus:ring-blue-300 transition-colors font-semibold"
              aria-label="Ver capitulo ${resultado.capitulo} completo de ${resultado.libro}"
            >
              <span class="text-xl" aria-hidden="true">&#128214;</span>
              Ver capitulo completo
            </a>
          </div>
        </article>
      `,
          )
          .join("");
      }
    }

    document.getElementById("searchForm")?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const searchInput = document.getElementById("searchInput") as HTMLInputElement | null;
      const query = searchInput?.value.trim() ?? "";
      if (!query) return;

      const loading = document.getElementById("loading");
      const results = document.getElementById("results");
      const noResults = document.getElementById("noResults");
      const initialMessage = document.getElementById("initialMessage");

      loading?.classList.remove("hidden");
      results?.classList.add("hidden");
      noResults?.classList.add("hidden");
      initialMessage?.classList.add("hidden");

      try {
        if (!searchReady) {
          const payload = await loadPrecomputedSearchIndex();
          initializeSearch(payload);
        }

        const resultados = buscar(query);
        displayResults(query, resultados);
      } catch (error) {
        console.error("Error en busqueda:", error);
        loading?.classList.add("hidden");
        alert("Error al buscar. Por favor intenta de nuevo.");
      }
    });

    const urlParams = new URLSearchParams(window.location.search);
    const queryParam = urlParams.get("q");
    if (queryParam) {
      const searchInput = document.getElementById("searchInput") as HTMLInputElement | null;
      if (searchInput) searchInput.value = queryParam;
      document.getElementById("searchForm")?.dispatchEvent(new Event("submit"));
    }
  </script>
</Layout>

<style>
  article {
    animation: slideIn 0.3s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    article {
      animation: none;
    }
  }
</style>
